        <PageObject XPosition="308.835275590551" YPosition="700.499779527559" OwnPage="1" ItemID="1888515205" ItemType="2" Width="34" Height="43.5512440944882" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" TextFlowMode="3" ImageScaleX="0.153153153153153" ImageScaleY="0.153153153153153" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="0" ImageRatio="1" ImagePageNumber="0" ImageFileName="../logos/lightbot-robot-2.png" ImageColorimetricIntent="0" UseEmbeddedProfile="0" Path="M0 0 L34 0 L34 43.5512 L0 43.5512 L0 0 Z" ContourLinePath="M0 0 L34 0 L34 43.5512 L0 43.5512 L0 0 Z" gXpos="308.835275590551" gYpos="700.499779527559" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1"/>
        <PageObject XPosition="128.347086614173" YPosition="48.3477165354331" OwnPage="0" ItemID="1951439247" ItemType="4" Width="223.937007874016" Height="538.582677165354" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="0" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L223.937 0 L223.937 538.583 L0 538.583 L0 0 Z" ContourLinePath="M0 0 L223.937 0 L223.937 538.583 L0 538.583 L0 0 Z" gXpos="128.347086614173" gYpos="48.3477165354331" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle LineSpacingMode="2" Font="Liberation Sans Regular"/>
                <Content Font="Liberation Sans Bold" Chars="The Zurich CoderDojo"/>
                <para LineSpacingMode="2"/>
                <Content Chars="The Zurich CoderDojo is a multilingual group (DE, EN, IT, PL, FR)."/>
                <para LineSpacingMode="2"/>
                <Content Chars="You will learn much more out of this sessions if you can attend regularly. Of course it does not have to be every week.  Bring your own laptop. If needed, we can also provide computers on demand.  No constant supervision by parents is necessary. Parents can relax in our small lounge."/>
                <para LineSpacingMode="2"/>
                <para LineSpacingMode="2"/>
                <Content Font="Liberation Sans Bold" Chars="Activities"/>
                <para LineSpacingMode="2"/>
                <Content Chars="Ninjas who have never been coding before, are introduced to Lightbot and learn the basics about programming."/>
                <para LineSpacingMode="2"/>
                <Content Chars="Our main platform is Scratch, a powerfull jigsaw-like programming environment."/>
                <para LineSpacingMode="2"/>
                <Content Chars="For the older ones who already know a bit of programming we suggest Python with PgZero."/>
                <para LineSpacingMode="2"/>
                <Content Chars="On top of that we run MaKey MaKey, Thymio  and other interesting workshops."/>
                <para LineSpacingMode="2"/>
                <para LineSpacingMode="2"/>
                <Content Font="Liberation Sans Bold" Chars="Get in touch"/>
                <para LineSpacingMode="2"/>
                <para LineSpacingMode="2"/>
                <Content Font="Liberation Sans Regular" Chars="If you want to join our bi-weekly dojo with your kids, please use our registration page:"/>
                <para LineSpacingMode="2"/>
                <Content Chars="https://luma.com/coderdojo-zurich"/>
                <para LineSpacingMode="2"/>
                <para LineSpacingMode="2"/>
                <Content Font="Liberation Sans Regular" Chars="And you can, of course, visit our website:"/>
                <para LineSpacingMode="2"/>
                <Content Chars="https://coderdojozh.ch/"/>
                <trail LineSpacingMode="2"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="705.055748031497" YPosition="160.435299212599" OwnPage="0" ItemID="1791896397" ItemType="4" Width="175.443881889764" Height="61.7500000000001" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="0" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L175.444 0 L175.444 61.75 L0 61.75 L0 0 Z" ContourLinePath="M0 0 L175.444 0 L175.444 61.75 L0 61.75 L0 0 Z" gXpos="705.055748031497" gYpos="160.435299212599" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle LineSpacingMode="1" Font="DejaVu Sans Condensed Bold" FontSize="23" FontColor="FromSVG#e0e0e0" ScaleVertical="100"/>
                <Content Font="DejaVu Sans Condensed Bold" FontSize="23" FontColor="FromSVG#e0e0e0" ScaleVertical="100" Chars="For Ninjas"/>
                <breakline/>
                <Content Font="DejaVu Sans Condensed Bold" FontSize="23" FontColor="FromSVG#e0e0e0" ScaleVertical="100" Chars="aged 7 to 17"/>
                <trail LineSpacingMode="1"/>
            </StoryText>
        </PageObject>
