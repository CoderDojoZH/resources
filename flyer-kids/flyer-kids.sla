            <StoryText>
                <DefaultStyle LineSpacingMode="2" Font="Bitstream Charter Regular"/>
                <Content Font="Bitstream Charter Regular" Chars="Lightbot is an educational game that introduces several principles of programming like sequence, conditions and loops. Kids use their problem solving skills to complete the puzzles!"/>
                <trail LineSpacingMode="2"/>
            </StoryText>
        </PageObject>
