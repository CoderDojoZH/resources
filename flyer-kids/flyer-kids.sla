            <StoryText>
                <DefaultStyle LineSpacingMode="0" Font="Bitstream Charter Regular"/>
                <Content Font="Bitstream Charter Regular" Chars="Pygame Zero lets you create games and basic programming skills with Python."/>
                <para LineSpacingMode="0"/>
                <Content Chars="It's the best next step after Scratch!"/>
                <trail LineSpacingMode="0"/>
