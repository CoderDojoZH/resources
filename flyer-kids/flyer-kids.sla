        <PageObject XPosition="408.977007874016" YPosition="757.287244094488" OwnPage="1" ItemID="622148626" ItemType="4" Width="223.937007874016" Height="462.885763779528" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="0" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L223.937 0 L223.937 462.886 L0 462.886 L0 0 Z" ContourLinePath="M0 0 L223.937 0 L223.937 462.886 L0 462.886 L0 0 Z" gXpos="408.977007874016" gYpos="757.287244094488" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle LineSpacingMode="2" Font="Bitstream Charter Regular"/>
                <Content Font="Bitstream Charter Regular" Chars="Scratch is a free educational programming language that was developed at the Massachusetts Institute of Technology (MIT) and has over 5 million registered users."/>
                <para LineSpacingMode="2"/>
                <para LineSpacingMode="2"/>
                <Content Font="Bitstream Charter Regular" Chars="Scratch is designed to be fun, educational, and easy to learn. It has the tools for creating interactive stories, games, art, simulations, and more. Scratch has its own paint editor, a sound editor and a ton of pre-made assets that make it easy to pick up by example."/>
                <para LineSpacingMode="2"/>
                <para LineSpacingMode="2"/>
                <Content Font="Bitstream Charter Regular" Chars="Scratch makes coding accessible by providing blocks like a jigsaw puzzle that you drag and combine into structures."/>
                <para LineSpacingMode="2"/>
                <para LineSpacingMode="2"/>
                <Content Font="Bitstream Charter Regular" Chars="It’s a powerful and simple tool that allows you to just try things out and see what happens."/>
                <trail LineSpacingMode="2"/>
            </StoryText>
        </PageObject>
