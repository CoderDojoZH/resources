        <PageObject XPosition="689.606929133859" YPosition="1000.24584251969" OwnPage="1" ItemID="1905429282" ItemType="4" Width="223.937007874016" Height="221.068661417324" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="14.1732283464567" TextToFrameDistanceTop="14.1732283464567" TextToFrameDistanceBottom="14.1732283464567" TextToFrameDistanceRight="14.1732283464567" VerticalAlignment="0" FirstLineOffset="0" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L223.937 0 L223.937 221.069 L0 221.069 L0 0 Z" ContourLinePath="M0 0 L223.937 0 L223.937 221.069 L0 221.069 L0 0 Z" gXpos="689.606929133859" gYpos="1000.24584251969" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Font="Bitstream Charter Regular"/>
                <Content Font="Bitstream Charter Regular" Chars="“Kids come in expecting to be able to make Minecraft."/>
                <para/>
                <Content Font="Bitstream Charter Regular" Chars="After spending about 30 minutes showing them just how to make a fish and a cat collide and behave properly, they would all gain a new appreciation of just what went into making a game work."/>
                <para/>
                <Content Font="Bitstream Charter Regular" Chars="After that, every kid would have all sorts of ideas of what to do to make the game their own.”"/>
                <para/>
                <Content Font="Bitstream Charter Italic" Chars="Adriel Wallick, games programmer. "/>
                <trail/>
            </StoryText>
        </PageObject>
