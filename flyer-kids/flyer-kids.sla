            <StoryText>
                <DefaultStyle LineSpacingMode="2" Font="Liberation Sans Regular"/>
                <Content Font="Liberation Sans Regular" Chars="CoderDojo is a volunteer led network of free computer programming clubs for young people aged 7-17."/>
                <para LineSpacingMode="2"/>
                <para LineSpacingMode="2"/>
                <Content Font="Liberation Sans Regular" Chars="CoderDojo puts an emphasis on self-motivated learning through project work, peer-to-peer mentoring and the creation of innovative projects."/>
                <para LineSpacingMode="2"/>
                <para LineSpacingMode="2"/>
                <Content Font="Liberation Sans Regular" Chars="There are over 450 CoderDojos teaching young people how to code in over 45 countries around the world."/>
                <trail LineSpacingMode="2"/>
            </StoryText>
        </PageObject>
