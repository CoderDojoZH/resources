            <StoryText>
                <DefaultStyle LineSpacingMode="2" Font="Liberation Sans Regular"/>
                <Content Chars="Every second Sunday, 15:00 - 17:00"/>
                <para LineSpacingMode="2"/>
                <Content Chars="@ Liip"/>
                <para LineSpacingMode="2"/>
                <Content Chars="Limmatstrasse 183"/>
                <para LineSpacingMode="2"/>
                <Content Chars="8048 Zürich"/>
